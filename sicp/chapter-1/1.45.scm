(define (repeated f n)
  (if (= n 1)
      f
      (lambda (x) (f ((repeated f (- n 1)) x)))))

(define (square x) (* x x))
(define (cube x) (* x x x))

(define (exp2 a n)
  (if (= n 0)
      1
      (* a (exp2 a (- n 1)))))

(define tolerance 0.00001)
(define (average a b) (/ (+ a b) 2))

(define (average-damp f)
  (lambda (x) (average x (f x))))

(define (fixed-point f first-guess)
  (define (close-enough? v1 v2)
    (< (abs (- v1 v2)) tolerance))
  (define (try guess)
    (let ((next (f guess)))
      (if (close-enough? guess next)
          next
          (try next))))
  (try first-guess))

(define (sqrt-alt x)
  (fixed-point ((repeated average-damp 1) (lambda (y) (/ x y)))
               1.0))

(sqrt-alt 9)

(define (log2 x)
  (/ (log x) (log 2)))

(define (cube-root x)
  (fixed-point ((repeated average-damp 1) (lambda (y) (/ x (square y))))
               1.0))

(cube-root 27)

(define (fourth-root x)
  (fixed-point ((repeated average-damp 2) (lambda (y) (/ x (cube y))))
               1.0))

(fourth-root 16)

(define (nth-root x n damping-factor)
  (fixed-point ((repeated average-damp damping-factor) (lambda (y) (/ x (exp2 y (- n 1))))) 1.0))

