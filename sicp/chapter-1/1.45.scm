(define (calculate-required-damping-factor n)
  (floor (log2 n)))

(define (nth-root-damped x n)
  (fixed-point
   (
    (repeated average-damp(calculate-required-damping-factor n))
    (lambda (y) (/ x (exp2 y (- n 1)))))
   1.0))

(let ((n 2)) (nth-root-damped (exp2 3 n) n))
(let ((n 3)) (nth-root-damped (exp2 3 n) n))
